{
  "name": "pullpage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "catalog:verify-tooling": "node scripts/verify-catalog-tooling.mts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && node scripts/seed-synthetic-catalog.mts",
    "db:seed:local": "node scripts/seed-synthetic-catalog.mts",
    "db:lint": "supabase db lint --local",
    "test": "vitest run",
    "test:integration": "node scripts/require-env.mjs TEST_CATALOG_DATABASE_URL LOCAL_MIGRATION_DATABASE_URL && vitest run tests/catalog.integration.test.ts",
    "test:e2e": "node scripts/require-env.mjs CATALOG_DATABASE_URL LOCAL_MIGRATION_DATABASE_URL && playwright test tests/e2e/catalog-cache.spec.ts && playwright test tests/e2e/catalog-browse.spec.ts tests/e2e/discoverability.spec.ts tests/e2e/catalog-smoke.spec.ts",
    "test:smoke": "node scripts/require-env.mjs CATALOG_DATABASE_URL && playwright test tests/e2e/catalog-smoke.spec.ts",
    "test:production": "node scripts/require-env.mjs CATALOG_DATABASE_URL && node scripts/test-production.mjs",
    "db:migrate": "node scripts/migrate-catalog.mts",
    "db:provision-runtime": "node scripts/provision-catalog-runtime.mjs",
    "db:verify-catalog": "node scripts/verify-catalog-database.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "17.3.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "pg": "8.16.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@electric-sql/pglite": "^0.4.3",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "7.9.0",
    "supabase": "2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
