{
  "name": "pullpage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local",
    "test": "vitest run",
    "test:integration": "node scripts/require-env.mjs TEST_CATALOG_DATABASE_URL SUPABASE_ADMIN_DATABASE_URL && vitest run tests/catalog.integration.test.ts tests/catalog-recovery.integration.test.ts",
    "test:e2e": "node scripts/require-env.mjs CATALOG_DATABASE_URL SUPABASE_ADMIN_DATABASE_URL CATALOG_REVALIDATE_SECRET && playwright test",
    "test:production": "node scripts/require-env.mjs CATALOG_DATABASE_URL SUPABASE_ADMIN_DATABASE_URL CATALOG_REVALIDATE_SECRET && node scripts/test-production.mjs",
    "test:resilience": "node scripts/require-env.mjs CATALOG_QUALIFICATION_ORIGINS SUPABASE_ADMIN_DATABASE_URL CATALOG_REVALIDATE_SECRET && node scripts/qualify-catalog-resilience.mjs",
    "db:push": "supabase db push --linked --include-seed",
    "db:push:dry-run": "supabase db push --linked --include-seed --dry-run",
    "db:provision-runtime": "node scripts/provision-catalog-runtime.mjs",
    "db:recover-product": "node scripts/change-catalog-product.mjs recover",
    "db:hard-delete-product": "node scripts/change-catalog-product.mjs hard-delete",
    "db:export-catalog": "node scripts/export-catalog-backup.mjs",
    "db:verify-catalog": "node scripts/verify-catalog-database.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "dotenv": "17.3.1",
    "next": "16.2.11",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "7.9.0",
    "supabase": "2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
