generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["catalog_private"]
}

model CatalogProduct {
  id                      String         @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  slug                    String         @unique @db.VarChar(96)
  cardName                String?        @map("card_name") @db.Text
  englishCollectorNumber  String?        @map("english_collector_number") @db.Text
  japaneseCollectorNumber String?        @map("japanese_collector_number") @db.Text
  englishSetName          String?        @map("english_set_name") @db.Text
  japaneseSetName         String?        @map("japanese_set_name") @db.Text
  rarityCode              String?        @map("rarity") @db.VarChar(32)
  rarityDefinition        CatalogRarity? @relation(fields: [rarityCode], references: [code])
  designName              String?        @map("design_name") @db.Text
  binderSleevePrice       Int?           @map("binder_sleeve_price")
  toploaderPrice          Int?           @map("toploader_price")
  productPreviewUrl       String?        @map("product_preview_url") @db.Text
  createdAt               DateTime       @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime       @default(dbgenerated("statement_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  isActive                Boolean        @default(true) @map("is_active")

  @@index([rarityCode], map: "catalog_product_rarity_idx")
  @@map("catalog_products")
  @@schema("catalog_private")
}

model CatalogRarity {
  code                 String           @id @db.VarChar(32)
  displayName          String           @map("display_name") @db.Text
  displayOrder         Int              @unique @map("display_order") @db.SmallInt
  isActive             Boolean          @default(true) @map("is_active")
  badgeBackgroundColor String           @map("badge_background_color") @db.VarChar(7)
  badgeForegroundColor String           @map("badge_foreground_color") @db.VarChar(7)
  products             CatalogProduct[]

  @@map("catalog_rarities")
  @@schema("catalog_private")
}
